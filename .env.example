# PostgreSQL connection string
DATABASE_URL="postgresql://upnext:upnext@localhost:5432/upnext_creators?schema=public"

# JWT signing secret (change in production)
JWT_SECRET="change-me-to-a-long-random-string"

# Seed / bootstrap admin credentials
ADMIN_EMAIL="nungseplangnan@gmail.com"
ADMIN_PASSWORD="William"

# Cloudinary media uploads (cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# Paystack (use sk_test_/pk_test_ locally; sk_live_/pk_live_ in production)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxx"

# Public base URL used in emailed links (accept/decline). Defaults to the
# site the booking was made on.
APP_URL="http://localhost:3000"

# Outgoing email (SMTP) for booking requests. Without these, emails are only
# logged to the server console. Gmail: smtp.gmail.com / 465 / app password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@example.com"
SMTP_PASS="app-password"
EMAIL_FROM="UpNext Creators <you@example.com>"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Creator {
  id                String   @id @default(cuid())
  name              String
  username          String   @unique
  email             String?  @unique
  avatar            String
  coverImage        String
  category          String
  city              String
  location          String
  bio               String
  rating            Float    @default(0)
  reviewCount       Int      @default(0)
  completedBookings Int      @default(0)
  rank              Int      @default(99)
  isSubscribed      Boolean  @default(false)
  // free | pro | premium
  subscriptionTier String   @default("free")
  whatsapp          String
  // JSON string array
  tags              String   @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  services      Service[]
  videos        CreatorVideo[]
  account       CreatorAccount?
  bookings      Booking[]
  conversations Conversation[]
}

model Service {
  id            String  @id @default(cuid())
  creatorId     String
  name          String
  description   String
  price         Float
  discountPrice Float?
  duration      String
  creator       Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
}

model CreatorVideo {
  id        String  @id @default(cuid())
  creatorId String
  title     String
  url       String
  earnings  Float   @default(0)
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
}

model CreatorAccount {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  creatorId String   @unique
  createdAt DateTime @default(now())
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model Booking {
  id          String   @id @default(cuid())
  creatorId   String
  creatorName String
  serviceId   String
  serviceName String
  price       Float
  date        String
  time        String
  clientName  String
  clientPhone String
  notes       String   @default("")
  // pending | confirmed | completed | cancelled
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  creator     Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([status])
}

model Conversation {
  id              String    @id @default(cuid())
  creatorId       String
  creatorName     String
  creatorAvatar   String
  lastMessage     String    @default("")
  lastMessageTime DateTime  @default(now())
  unread          Int       @default(0)
  creator         Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@index([creatorId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  senderName     String
  text           String
  isOwn          Boolean      @default(false)
  timestamp      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Category {
  id   String @id @default(cuid())
  name String @unique
}

model AdminSetting {
  id       String @id @default("admin")
  password String @default("upnext2024")
}
